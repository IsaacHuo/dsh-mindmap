{
  "name": "@huoweifang/dsh-mindmap",
  "version": "0.3.0",
  "description": "Outliner and mind-map plugin for DeepSeek Harness: edit one document as a nested outline or a live mind map, with local autosave, backups and Markdown/OPML import and export.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Weifang Huo <2210286979@qq.com>",
  "homepage": "https://github.com/IsaacHuo/dsh-mindmap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IsaacHuo/dsh-mindmap.git"
  },
  "bugs": {
    "url": "https://github.com/IsaacHuo/dsh-mindmap/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mindmap",
    "outline",
    "outliner",
    "notes",
    "markdown",
    "opml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "harness": "node scripts/harness.mjs",
    "e2e": "node e2e/outline.e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
